{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nurse credentials import",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "nurses"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nurses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["user", "password", "credentials"],
        "properties": {
          "user": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}$"
          },
          "password": {
            "type": "string",
            "minLength": 4,
            "maxLength": 128
          },
          "credentials": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "licenseNumber",
                "certification",
                "issuingBody",
                "issueDate",
                "expirationDate"
              ],
              "properties": {
                "licenseNumber": {
                  "type": "string",
                  "pattern": "^[A-Z0-9][A-Z0-9-]{4,29}$"
                },
                "certification": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150
                },
                "issuingBody": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 150
                },
                "issueDate": {
                  "type": "string",
                  "format": "date"
                },
                "expirationDate": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      }
    }
  }
}
